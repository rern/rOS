ACTION=="add", \
SUBSYSTEM=="bluetooth", \
ENV{DEVTYPE}=="host", \
DEVPATH=="*/usb*/bluetooth/*", \
RUN+="/srv/http/bash/settings/networks.sh usbbluetoothon"

ACTION=="remove", \
SUBSYSTEM=="bluetooth", \
ENV{DEVTYPE}=="host", \
DEVPATH=="*/usb*/bluetooth/*", \
RUN+="/srv/http/bash/settings/networks.sh usbbluetoothoff"
